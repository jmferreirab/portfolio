---
import {getCollection} from 'astro:content'; import ExperienceItem from './ExperienceItem.astro'; import {getUI,type Locale} from '../i18n/ui';
const locale=(Astro.currentLocale??'en') as Locale; const t=getUI(locale); const entries=await getCollection('experience',({data})=>data.locale===locale); entries.sort((a,b)=>+new Date(b.data.startDate)-+new Date(a.data.startDate));
---
<section id="experience" class="py-16 sm:py-24 border-t"><div class="max-w-3xl mx-auto px-6"><h2 class="text-3xl sm:text-4xl font-bold mb-12">{t.experience.title}</h2><div class="space-y-8">{entries.map(e=><ExperienceItem locale={locale} presentLabel={t.experience.present} {...e.data}/>)}</div></div></section>