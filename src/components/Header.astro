---
import { site } from '../data/site';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, type Locale } from '../i18n/ui';
import { SECTION_IDS } from '../constants/navigation';
import LangSwitch from './LangSwitch.astro';
import MobileMenuSidebar from './MobileMenuSidebar.astro';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = useTranslations(locale);
const navItems = [
  { label: t.nav.about, href: `#${SECTION_IDS.about}` },
  { label: t.nav.experience, href: `#${SECTION_IDS.experience}` },
  { label: t.nav.work, href: `#${SECTION_IDS.projects}` },
  { label: t.nav.skills, href: `#${SECTION_IDS.skills}` },
  { label: t.nav.contact, href: `#${SECTION_IDS.contact}` },
];
const navItemStyle =
  'text-sm text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-200 transition-colors';
---

<header
  class="sticky top-0 z-50 border-b border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-950"
>
  <nav class="mx-auto flex max-w-3xl items-center justify-between px-6 py-4">
    <a
      href={getRelativeLocaleUrl(locale, '')}
      class="text-lg font-bold text-gray-900 transition-colors hover:text-blue-600 dark:text-gray-100 dark:hover:text-blue-400"
    >
      {site.name}
    </a>
    <div class="flex items-center gap-8">
      <ul class="hidden items-center gap-8 md:flex">
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} class={navItemStyle}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <LangSwitch styles={navItemStyle} />
        </li>
      </ul>
      <button
        id="theme-toggle-btn"
        class="rounded-lg p-2"
        aria-label={t.common.themeToggle}
        title={t.common.themeToggle}
      >
        <span data-icon class="text-lg">◐</span>
      </button>
      <!-- Mobile menu indicator -->
      <button
        id="mobile-menu-button"
        class="text-gray-600 hover:text-gray-900 md:hidden dark:text-gray-400 dark:hover:text-gray-200"
        aria-label="Toggle menu"
      >
        <svg
          id="mobile-menu-icon"
          class="size-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"
          >
          </path>
        </svg>
      </button>
    </div>
  </nav>
</header>

<MobileMenuSidebar navItems={navItems} />
