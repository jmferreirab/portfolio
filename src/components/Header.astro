---
import { site } from '../data/site';
import { translations } from '../i18n/translations';

const navItems = [
  { key: 'about', href: '#about' },
  { key: 'experience', href: '#experience' },
  { key: 'work', href: '#work' },
  { key: 'skills', href: '#skills' },
  { key: 'contact', href: '#contact' },
];
---

<header class="sticky top-0 z-50 bg-white dark:bg-gray-950 border-b border-gray-200 dark:border-gray-800">
  <nav class="max-w-3xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href="#" class="font-bold text-lg text-gray-900 dark:text-gray-100 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
      {site.name}
    </a>
    <div class="flex items-center gap-8">
      <ul class="hidden sm:flex gap-8 items-center">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              data-i18n={`nav.${item.key}`}
              class="text-sm text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-200 transition-colors"
            >
              {translations.en.nav[item.key as keyof typeof translations.en.nav]}
            </a>
          </li>
        ))}
      </ul>
      <button
        id="language-toggle-btn"
        data-language-toggle
        data-i18n-locale
        class="text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-200 transition-colors"
        aria-label="Switch to Spanish"
        title="Switch to Spanish"
      >
        ES
      </button>
      <button
        id="theme-toggle-btn"
        class="p-2 rounded-lg"
        aria-label="Switch to dark mode"
        title="Switch to dark mode"
      >
        <span data-icon class="text-lg">◐</span>
      </button>
      <div class="sm:hidden text-gray-600 dark:text-gray-400">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </div>
    </div>
  </nav>
</header>
