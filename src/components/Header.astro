---
import {site} from '../data/site'; import {getRelativeLocaleUrl} from 'astro:i18n'; import {getUI,type Locale} from '../i18n/ui';
const locale=(Astro.currentLocale??'en') as Locale; const t=getUI(locale); const otherLocale=locale==='en'?'es':'en'; const nav=[{l:t.nav.about,h:'#about'},{l:t.nav.experience,h:'#experience'},{l:t.nav.work,h:'#work'},{l:t.nav.skills,h:'#skills'},{l:t.nav.contact,h:'#contact'}];
---
<header class="sticky top-0 z-50 bg-white dark:bg-gray-950 border-b border-gray-200 dark:border-gray-800"><nav class="max-w-3xl mx-auto px-6 py-4 flex justify-between items-center"><a href={getRelativeLocaleUrl(locale,'')} class="font-bold text-lg">{site.name}</a><div class="flex items-center gap-8"><ul class="hidden sm:flex gap-8">{nav.map(x=><li><a href={x.h}>{x.l}</a></li>)}</ul><a href={getRelativeLocaleUrl(otherLocale,'')} lang={otherLocale}>{t.language.switch}</a><button id="theme-toggle-btn" class="p-2" aria-label="Switch theme"><span data-icon>◐</span></button></div></nav></header>