---
import { site } from '../data/site';

const navItems = [
  { label: 'About', href: '#about' },
  { label: 'Experience', href: '#experience' },
  { label: 'Work', href: '#work' },
  { label: 'Skills', href: '#skills' },
  { label: 'Contact', href: '#contact' },
];
---

<header class="sticky top-0 z-50 bg-white border-b border-gray-200">
  <nav class="max-w-3xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href="#" class="font-bold text-lg text-gray-900 hover:text-blue-600 transition-colors">
      {site.name}
    </a>
    <ul class="hidden sm:flex gap-8 items-center">
      {navItems.map(item => (
        <li>
          <a href={item.href} class="text-sm text-gray-600 hover:text-gray-900 transition-colors">
            {item.label}
          </a>
        </li>
      ))}
    </ul>
    <!-- Mobile menu indicator -->
    <div class="sm:hidden text-gray-600">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </div>
  </nav>
</header>
