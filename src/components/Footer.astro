---
import { site } from '../data/site';
import ChevronDoubleUp from '../icons/ChevronDoubleUp.astro';
import { useTranslations, type Locale } from '../i18n/ui';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = useTranslations(locale);
const currentYear = new Date().getFullYear();
---

<footer
  class="relative border-t border-gray-800 bg-gray-900 py-12 text-gray-300 dark:border-gray-800 dark:bg-gray-950 dark:text-gray-400"
>
  <a
    href="#"
    aria-label="Back to top"
    class="absolute -top-px left-1/2 z-10 flex size-12 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border-2 border-gray-900 bg-white text-gray-900 shadow-sm transition-colors hover:bg-gray-100 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-100 dark:hover:bg-gray-700"
  >
    <ChevronDoubleUp class="size-8" />
  </a>
  <div class="mx-auto max-w-3xl px-6">
    <div class="mb-8 grid grid-cols-1 gap-8 md:grid-cols-2">
      <div>
        <h3 class="mb-4 font-bold text-white dark:text-gray-100">
          {site.name}
        </h3>
        <p class="text-sm leading-relaxed">
          {t.footer.description}
        </p>
      </div>
      <div>
        <h3 class="mb-4 font-bold text-white dark:text-gray-100">
          {t.footer.quickLinks}
        </h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a
              href="#about"
              class="transition-colors hover:text-white dark:hover:text-gray-200"
              >{t.nav.about}</a
            >
          </li>
          <li>
            <a
              href="#experience"
              class="transition-colors hover:text-white dark:hover:text-gray-200"
              >{t.nav.experience}</a
            >
          </li>
          <li>
            <a
              href="#work"
              class="transition-colors hover:text-white dark:hover:text-gray-200"
              >{t.nav.work}</a
            >
          </li>
          <li>
            <a
              href="#contact"
              class="transition-colors hover:text-white dark:hover:text-gray-200"
              >{t.nav.contact}</a
            >
          </li>
        </ul>
      </div>
    </div>
    <div
      class="flex flex-col gap-4 border-t border-gray-800 pt-8 text-sm md:flex-row md:items-center md:justify-between dark:border-gray-800"
    >
      <p>
        © {currentYear}
        {site.name}. {t.footer.rights}
      </p>
      <div class="flex gap-6">
        <a
          href={site.github}
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors hover:text-white dark:hover:text-gray-200"
        >
          GitHub
        </a>
        <a
          href={site.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors hover:text-white dark:hover:text-gray-200"
        >
          LinkedIn
        </a>
        <a
          href={`mailto:${site.email}`}
          class="transition-colors hover:text-white dark:hover:text-gray-200"
        >
          Email
        </a>
      </div>
    </div>
  </div>
</footer>
