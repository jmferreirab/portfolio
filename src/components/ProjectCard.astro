---
const {labels,title,summary,problem,solution,result,technologies,repository,demo}=Astro.props;
---
<article class="pb-10 border-b"><h3 class="text-2xl font-bold mb-3">{title}</h3><p class="mb-6 text-lg">{summary}</p><div class="grid sm:grid-cols-2 gap-6 mb-6"><div><h4 class="font-semibold">{labels.problem}</h4><p>{problem}</p></div><div><h4 class="font-semibold">{labels.solution}</h4><p>{solution}</p></div></div>{result&&<div class="mb-6"><h4 class="font-semibold">{labels.result}</h4><p>{result}</p></div>}<div class="flex flex-wrap gap-2">{technologies.map(t=><span class="px-3 py-1 bg-blue-50 rounded text-sm">{t}</span>)}</div>{(repository||demo)&&<div class="flex gap-4 mt-4 pt-4 border-t">{repository&&<a href={repository}> {labels.repository} →</a>}{demo&&<a href={demo}> {labels.demo} →</a>}</div>}</article>