---
import { translations } from '../i18n/translations';

interface Props {
  id: string;
  technologies: string[];
  repository?: string;
  demo?: string;
}

const { id, technologies, repository, demo } = Astro.props;
const project = translations.en.work.projects[id as keyof typeof translations.en.work.projects];
---
<article class="pb-10 border-b border-gray-200 dark:border-gray-800 last:border-b-0">
  <h3 data-i18n={`work.projects.${id}.title`} class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-3">{project?.title}</h3>
  <p data-i18n={`work.projects.${id}.summary`} class="text-gray-700 dark:text-gray-300 mb-6 leading-relaxed text-lg">{project?.summary}</p>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-6 text-sm">
    <div><h4 data-i18n="work.problem" class="font-semibold text-gray-900 dark:text-gray-100 mb-2">{translations.en.work.problem}</h4><p data-i18n={`work.projects.${id}.problem`} class="text-gray-700 dark:text-gray-300 leading-relaxed">{project?.problem}</p></div>
    <div><h4 data-i18n="work.solution" class="font-semibold text-gray-900 dark:text-gray-100 mb-2">{translations.en.work.solution}</h4><p data-i18n={`work.projects.${id}.solution`} class="text-gray-700 dark:text-gray-300 leading-relaxed">{project?.solution}</p></div>
  </div>
  {project?.result && <div class="mb-6 text-sm"><h4 data-i18n="work.result" class="font-semibold text-gray-900 dark:text-gray-100 mb-2">{translations.en.work.result}</h4><p data-i18n={`work.projects.${id}.result`} class="text-gray-700 dark:text-gray-300 leading-relaxed">{project.result}</p></div>}
  <div class="flex flex-wrap gap-2 mb-4">{technologies.map(tech => <span class="inline-flex px-3 py-1 bg-blue-50 dark:bg-blue-950 text-blue-700 dark:text-blue-300 rounded text-sm font-medium">{tech}</span>)}</div>
  {(repository || demo) && <div class="flex flex-wrap gap-4 pt-4 border-t border-gray-200 dark:border-gray-800">
    {repository && <a href={repository} target="_blank" rel="noopener noreferrer" data-i18n="work.repository" class="text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 font-medium transition-colors">{translations.en.work.repository} →</a>}
    {demo && <a href={demo} target="_blank" rel="noopener noreferrer" data-i18n="work.demo" class="text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 font-medium transition-colors">{translations.en.work.demo} →</a>}
  </div>}
</article>
