---
import { site } from '../data/site';
import { useTranslations, type Locale } from '../i18n/ui';
import { SECTION_IDS } from '../constants/navigation';
const t = useTranslations((Astro.currentLocale ?? 'en') as Locale);
---

<section
  id={SECTION_IDS.contact}
  class="border-t border-gray-200 bg-gray-50 py-16 md:py-24 dark:border-gray-800 dark:bg-gray-900"
>
  <div class="mx-auto max-w-3xl px-6 text-center">
    <h2
      class="mb-6 text-3xl font-bold text-gray-900 md:text-4xl dark:text-gray-100"
    >
      {t.contact.title}
    </h2>
    <p
      class="mx-auto mb-8 max-w-2xl text-lg leading-relaxed text-gray-700 dark:text-gray-300"
    >
      {t.contact.text}
    </p>
    <div class="flex flex-col items-center justify-center gap-6 md:flex-row">
      <a
        href={`mailto:${site.email}`}
        class="inline-flex items-center gap-2 rounded bg-blue-600 px-6 py-3 font-medium text-white transition-colors hover:bg-blue-700 dark:bg-blue-600 dark:text-white dark:hover:bg-blue-700"
      >
        {t.contact.email}
      </a>
      <a
        href={site.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 font-medium text-blue-600 transition-colors hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300"
      >
        {t.contact.linkedin} →
      </a>
      <a
        href={site.github}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 font-medium text-blue-600 transition-colors hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300"
      >
        {t.contact.github} →
      </a>
    </div>
  </div>
</section>
