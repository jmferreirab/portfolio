---
import {site} from '../data/site'; import {getUI,type Locale} from '../i18n/ui'; const t=getUI((Astro.currentLocale??'en') as Locale);
---
<section id="contact" class="py-16 sm:py-24 border-t"><div class="max-w-3xl mx-auto px-6 text-center"><h2 class="text-3xl sm:text-4xl font-bold mb-6">{t.contact.title}</h2><p class="text-lg mb-8">{t.contact.text}</p><div class="flex flex-col sm:flex-row gap-6 justify-center"><a href={${`mailto:${site.email}`}>{t.contact.email}</a><a href={site.linkedin}>{t.contact.linkedin} →</a><a href={site.github}>{t.contact.github} →</a></div></div></section>