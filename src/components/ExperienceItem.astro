---
const {locale,presentLabel,company,role,location,startDate,endDate,summary,highlights,technologies}=Astro.props; const f=(d:Date)=>new Intl.DateTimeFormat(locale==='es'?'es-CO':'en-US',{year:'numeric',month:'short'}).format(d); const range=endDate?f(startDate)+' - '+f(endDate):f(startDate)+' - '+presentLabel;
---
<div class="pb-12 border-b"><div class="flex flex-col sm:flex-row sm:justify-between gap-2"><h3 class="text-xl font-bold">{company}</h3><span>{range}</span></div><div class="flex gap-2 text-lg"><b>{role}</b><span>·</span><span>{location}</span></div><p class="my-4">{summary}</p><ul class="mb-6 space-y-2">{highlights.map(h=><li>• {h}</li>)}</ul><div class="flex flex-wrap gap-2">{technologies.map(t=><span class="px-3 py-1 bg-blue-50 rounded text-sm">{t}</span>)}</div></div>