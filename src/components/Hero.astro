---
import { site } from '../data/site';

const navItems = [
  { label: 'Email', href: `mailto:${site.email}`, icon: 'envelope' },
  { label: 'GitHub', href: site.github, icon: 'github' },
  { label: 'LinkedIn', href: site.linkedin, icon: 'linkedin' },
];
---

<section class="py-16 sm:py-24 bg-white dark:bg-gray-950">
  <div class="max-w-3xl mx-auto px-6">
    <div class="space-y-6">
      <div>
        <h1
          class="text-5xl sm:text-6xl font-bold text-gray-900 dark:text-gray-100 mb-2"
        >
          {site.name}
        </h1>
        <p
          class="text-2xl sm:text-3xl text-gray-600 dark:text-gray-400 font-light"
        >
          {site.title}
        </p>
      </div>

      <p
        class="text-lg text-gray-700 dark:text-gray-300 leading-relaxed max-w-2xl"
      >
        <strong>Python specialist</strong> with 5+ years of experience developing
        data-intensive systems.
      </p>
      <p
        class="text-lg text-gray-700 dark:text-gray-300 leading-relaxed max-w-2xl"
      >
        I am focused on building software that is reliable, secure, and actually
        enjoyable to use. I pay close attention to details, and strongly believe
        that working closely with users is critical to build better products.
      </p>
    </div>

    <div class="flex flex-wrap gap-6 pt-4">
      <a
        href={`mailto:${site.email}`}
        class="inline-flex items-center gap-2 text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 font-medium transition-colors"
      >
        <span>Get in touch</span>
        <span>→</span>
      </a>
      <a
        href={site.github}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-200 transition-colors"
      >
        <span>GitHub</span>
      </a>
      <a
        href={site.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-200 transition-colors"
      >
        <span>LinkedIn</span>
      </a>
    </div>
  </div>
</section>
