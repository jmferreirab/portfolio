---
import { site } from '../data/site';
import { useTranslations, type Locale } from '../i18n/ui';
const t = useTranslations((Astro.currentLocale ?? 'en') as Locale);
---

<section class="py-16 sm:py-24 bg-white dark:bg-gray-950">
  <div class="max-w-3xl mx-auto px-6">
    <div class="space-y-6">
      <div>
        <h1
          class="text-5xl sm:text-6xl font-bold text-gray-900 dark:text-gray-100 mb-2"
        >
          {site.name}
        </h1>
        <p
          class="text-2xl sm:text-3xl text-gray-600 dark:text-gray-400 font-light"
        >
          {site.title}
        </p>
      </div>

      <p
        class="text-lg text-gray-700 dark:text-gray-300 leading-relaxed max-w-2xl"
      >
        <strong>{t.hero.specialist}</strong>
        {t.hero.specialistText}
      </p>
      <p
        class="text-lg text-gray-700 dark:text-gray-300 leading-relaxed max-w-2xl"
      >
        {t.hero.paragraph}
      </p>
    </div>

    <div class="flex flex-wrap gap-6 pt-4">
      <a
        href={`mailto:${site.email}`}
        class="inline-flex items-center gap-2 text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 font-medium transition-colors"
      >
        <span>{t.hero.getInTouch}</span>
        <span>→</span>
      </a>
      <a
        href={site.github}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-200 transition-colors"
      >
        <span>GitHub</span>
      </a>
      <a
        href={site.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-200 transition-colors"
      >
        <span>LinkedIn</span>
      </a>
    </div>
  </div>
</section>
