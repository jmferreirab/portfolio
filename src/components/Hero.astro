---
import { translations } from '../i18n/translations';
---

<section class="py-16 sm:py-24 bg-white dark:bg-gray-950">
  <div class="max-w-3xl mx-auto px-6">
    <div class="space-y-6">
      <div>
        <h1 class="text-5xl sm:text-6xl font-bold text-gray-900 dark:text-gray-100 mb-2">Manuel Ferreira</h1>
        <p data-i18n="hero.title" class="text-2xl sm:text-3xl text-gray-600 dark:text-gray-400 font-light">{translations.en.hero.title}</p>
      </div>
      <p data-i18n="hero.lead" data-i18n-html="true" class="text-lg text-gray-700 dark:text-gray-300 leading-relaxed max-w-2xl">{translations.en.hero.lead}</p>
      <p data-i18n="hero.body" class="text-lg text-gray-700 dark:text-gray-300 leading-relaxed max-w-2xl">{translations.en.hero.body}</p>
    </div>
    <div class="flex flex-wrap gap-6 pt-4">
      <a href="mailto:serious.owl551@passinbox.com" class="inline-flex items-center gap-2 text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 font-medium transition-colors">
        <span data-i18n="hero.contact">{translations.en.hero.contact}</span><span>→</span>
      </a>
      <a href="https://github.com/jmferreirab" target="_blank" rel="noopener noreferrer" class="text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-200 transition-colors">GitHub</a>
      <a href="https://www.linkedin.com/in/ferreiradevs/" target="_blank" rel="noopener noreferrer" class="text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-200 transition-colors">LinkedIn</a>
    </div>
  </div>
</section>
