---
import { site } from '../data/site';
import { useTranslations, type Locale } from '../i18n/ui';
const t = useTranslations((Astro.currentLocale ?? 'en') as Locale);
---

<section class="bg-white py-16 sm:py-24 dark:bg-gray-950">
  <div class="mx-auto max-w-3xl px-6">
    <div class="space-y-6">
      <div>
        <h1
          class="mb-2 text-5xl font-bold text-gray-900 sm:text-6xl dark:text-gray-100"
        >
          {site.name}
        </h1>
        <p
          class="text-2xl font-light text-gray-600 sm:text-3xl dark:text-gray-400"
        >
          {t.role}
        </p>
      </div>

      <p
        class="max-w-2xl text-lg leading-relaxed text-gray-700 dark:text-gray-300"
      >
        <strong>{t.hero.specialist}</strong>
        {t.hero.specialistText}
      </p>
      <p
        class="max-w-2xl text-lg leading-relaxed text-gray-700 dark:text-gray-300"
      >
        {t.hero.paragraph}
      </p>
    </div>

    <div class="flex flex-wrap gap-6 pt-4">
      <a
        href={`mailto:${site.email}`}
        class="inline-flex items-center gap-2 font-medium text-blue-600 transition-colors hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300"
      >
        <span>{t.hero.getInTouch}</span>
        <span>→</span>
      </a>
      <a
        href={site.github}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-gray-600 transition-colors hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-200"
      >
        <span>GitHub</span>
      </a>
      <a
        href={site.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-gray-600 transition-colors hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-200"
      >
        <span>LinkedIn</span>
      </a>
    </div>
  </div>
</section>
