---
import { site } from '../data/site';

const navItems = [
  { label: 'Email', href: `mailto:${site.email}`, icon: 'envelope' },
  { label: 'GitHub', href: site.github, icon: 'github' },
  { label: 'LinkedIn', href: site.linkedin, icon: 'linkedin' },
];
---

<section class="py-16 sm:py-24 bg-white">
  <div class="max-w-3xl mx-auto px-6">
    <div class="space-y-6">
      <div>
        <h1 class="text-5xl sm:text-6xl font-bold text-gray-900 mb-2">
          {site.name}
        </h1>
        <p class="text-2xl sm:text-3xl text-gray-600 font-light">
          {site.title}
        </p>
      </div>

      <p class="text-lg text-gray-700 leading-relaxed max-w-2xl">
        {site.introduction}
      </p>

      <div class="flex flex-wrap gap-6 pt-4">
        <a href={`mailto:${site.email}`} class="inline-flex items-center gap-2 text-blue-600 hover:text-blue-700 font-medium transition-colors">
          <span>Get in touch</span>
          <span>→</span>
        </a>
        <a href={site.github} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-gray-600 hover:text-gray-900 transition-colors">
          <span>GitHub</span>
        </a>
        <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-gray-600 hover:text-gray-900 transition-colors">
          <span>LinkedIn</span>
        </a>
      </div>
    </div>
  </div>
</section>
