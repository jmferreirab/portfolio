---
import {site} from '../data/site'; import {getUI,type Locale} from '../i18n/ui'; const t=getUI((Astro.currentLocale??'en') as Locale);
---
<section class="py-16 sm:py-24"><div class="max-w-3xl mx-auto px-6 space-y-6"><div><h1 class="text-5xl sm:text-6xl font-bold">{site.name}</h1><p class="text-2xl sm:text-3xl text-gray-600">{t.role}</p></div><p class="text-lg"><strong>{t.hero.specialist}</strong> {t.hero.specialistText}</p><p class="text-lg">{t.hero.paragraph}</p><div class="flex gap-6"><a href={${`mailto:${site.email}`}>{t.hero.getInTouch} →</a><a href={site.github}>GitHub</a><a href={site.linkedin}>LinkedIn</a></div></div></section>