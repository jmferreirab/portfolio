---
import { useTranslations, type Locale } from '../i18n/ui';

const t = useTranslations((Astro.currentLocale ?? 'en') as Locale);
const aboutItems = [
  [t.about.background, t.about.backgroundText],
  [t.about.previousWork, t.about.previousWorkText],
  [t.about.humanSide, t.about.humanSideText],
] as const;
---

<section
  id="about"
  class="py-16 sm:py-24 bg-gray-50 dark:bg-gray-900 border-t border-gray-200 dark:border-gray-800"
>
  <div class="max-w-3xl mx-auto px-6">
    <h2
      class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-gray-100 mb-8"
    >
      {t.about.title}
    </h2>

    <div class="space-y-6 text-gray-700 dark:text-gray-300 leading-relaxed">
      <ul class="list-disc space-y-6 pl-6 text-lg">
        {
          aboutItems.map(([label, text]) => (
            <li>
              <strong class="font-semibold">{label}</strong>
              <span>{text}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
