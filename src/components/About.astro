---
import {getUI,type Locale} from '../i18n/ui'; const t=getUI((Astro.currentLocale??'en') as Locale);
---
<section id="about" class="py-16 sm:py-24 border-t"><div class="max-w-3xl mx-auto px-6"><h2 class="text-3xl sm:text-4xl font-bold mb-8">{t.about.title}</h2><ul class="list-disc space-y-6 pl-6 text-lg"><li><strong>{t.about.background}</strong> {t.about.backgroundText}</li><li><strong>{t.about.previousWork}</strong> {t.about.previousWorkText}</li><li><strong>{t.about.humanSide}</strong> {t.about.humanSideText}</li></ul></div></section>