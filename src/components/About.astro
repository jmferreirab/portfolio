---
import { useTranslations, type Locale } from '../i18n/ui';
import { SECTION_IDS } from '../constants/navigation';

const t = useTranslations((Astro.currentLocale ?? 'en') as Locale);
const aboutItems = [
  [t.about.background, t.about.backgroundText],
  [t.about.previousWork, t.about.previousWorkText],
  [t.about.humanSide, t.about.humanSideText],
] as const;
---

<section
  id={SECTION_IDS.about}
  class="border-t border-gray-200 bg-gray-50 py-16 sm:py-24 dark:border-gray-800 dark:bg-gray-900"
>
  <div class="mx-auto max-w-3xl px-6">
    <h2
      class="mb-8 text-3xl font-bold text-gray-900 sm:text-4xl dark:text-gray-100"
    >
      {t.about.title}
    </h2>

    <div class="space-y-6 leading-relaxed text-gray-700 dark:text-gray-300">
      <ul class="list-disc space-y-6 pl-6 text-lg">
        {
          aboutItems.map(([label, text]) => (
            <li>
              <strong class="font-semibold">{label}</strong>
              <span>{text}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
