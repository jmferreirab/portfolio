---
import { translations } from '../i18n/translations';
---
<section id="about" class="py-16 sm:py-24 bg-gray-50 dark:bg-gray-900 border-t border-gray-200 dark:border-gray-800">
  <div class="max-w-3xl mx-auto px-6">
    <h2 data-i18n="about.title" class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-gray-100 mb-8">{translations.en.about.title}</h2>
    <div class="space-y-6 text-gray-700 dark:text-gray-300 leading-relaxed">
      <ul class="list-disc space-y-6 pl-6 text-lg">
        <li><strong data-i18n="about.backgroundLabel" class="font-semibold">{translations.en.about.backgroundLabel}</strong> <span data-i18n="about.background">{translations.en.about.background}</span></li>
        <li><strong data-i18n="about.previousLabel" class="font-semibold">{translations.en.about.previousLabel}</strong> <span data-i18n="about.previous">{translations.en.about.previous}</span></li>
        <li><strong data-i18n="about.humanLabel" class="font-semibold">{translations.en.about.humanLabel}</strong> <span data-i18n="about.human">{translations.en.about.human}</span></li>
      </ul>
    </div>
  </div>
</section>
