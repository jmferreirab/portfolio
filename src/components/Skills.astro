---
import {site} from '../data/site'; import {getUI,type Locale} from '../i18n/ui'; type K=keyof typeof site.skills; const t=getUI((Astro.currentLocale??'en') as Locale); const c:[K,string][]=[['languages',t.skills.languages],['backend',t.skills.backend],['databases',t.skills.databases],['infrastructure',t.skills.infrastructure],['cloud',t.skills.cloud],['tools',t.skills.tools],['testing',t.skills.testing],['ai',t.skills.ai]];
---
<section id="skills" class="py-16 sm:py-24 border-t"><div class="max-w-3xl mx-auto px-6"><h2 class="text-3xl sm:text-4xl font-bold mb-12">{t.skills.title}</h2><div class="grid sm:grid-cols-2 gap-8">{c.map(([k,l])=><div><h3 class="font-bold mb-4">{l}</h3><div class="flex flex-wrap gap-2">{(site.skills[k] as string[]).map(s=><span class="px-3 py-1 bg-gray-100 rounded text-sm">{s}</span>)}</div></div>)}</div></div></section>