---
import { site } from '../data/site';
import { useTranslations, type Locale } from '../i18n/ui';
import { SECTION_IDS } from '../constants/navigation';
const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = useTranslations(locale);
type SkillCategory = keyof typeof site.skills;

const categories = [
  { key: 'languages', label: t.skills.languages },
  { key: 'backend', label: t.skills.backend },
  { key: 'databases', label: t.skills.databases },
  { key: 'infrastructure', label: t.skills.infrastructure },
  { key: 'cloud', label: t.skills.cloud },
  { key: 'tools', label: t.skills.tools },
  { key: 'testing', label: t.skills.testing },
  { key: 'ai', label: t.skills.ai },
] satisfies { key: SkillCategory; label: string }[];

// Filter out empty categories
const activeCategories = categories.filter(
  (cat) => site.skills[cat.key] && (site.skills[cat.key] as string[]).length > 0
);
---

<section
  id={SECTION_IDS.skills}
  class="border-t border-gray-200 bg-white py-16 md:py-24 dark:border-gray-800 dark:bg-gray-950"
>
  <div class="mx-auto max-w-3xl px-6">
    <h2
      class="mb-12 text-3xl font-bold text-gray-900 md:text-4xl dark:text-gray-100"
    >
      {t.skills.title}
    </h2>
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      {
        activeCategories.map((cat) => (
          <div>
            <h3 class="mb-4 text-lg font-bold text-gray-900 dark:text-gray-100">
              {cat.label}
            </h3>
            <div class="flex flex-wrap gap-2">
              {(site.skills[cat.key] as string[]).map((skill) => (
                <span class="inline-flex rounded bg-gray-100 px-3 py-1 text-sm font-medium text-gray-700 hover:bg-blue-50 hover:text-blue-700 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-blue-950 dark:hover:text-blue-300">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
