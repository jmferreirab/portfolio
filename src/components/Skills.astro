---
import { site } from '../data/site';
import { useTranslations, type Locale } from '../i18n/ui';
const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = useTranslations(locale);
type SkillCategory = keyof typeof site.skills;

const categories = [
  { key: 'languages', label: t.skills.languages },
  { key: 'backend', label: t.skills.backend },
  { key: 'databases', label: t.skills.databases },
  { key: 'infrastructure', label: t.skills.infrastructure },
  { key: 'cloud', label: t.skills.cloud },
  { key: 'tools', label: t.skills.tools },
  { key: 'testing', label: t.skills.testing },
  { key: 'ai', label: t.skills.ai },
] satisfies { key: SkillCategory; label: string }[];

// Filter out empty categories
const activeCategories = categories.filter(
  (cat) => site.skills[cat.key] && (site.skills[cat.key] as string[]).length > 0
);
---

<section
  id="skills"
  class="py-16 sm:py-24 bg-white dark:bg-gray-950 border-t border-gray-200 dark:border-gray-800"
>
  <div class="max-w-3xl mx-auto px-6">
    <h2
      class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-gray-100 mb-12"
    >
      {t.skills.title}
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
      {
        activeCategories.map((cat) => (
          <div>
            <h3 class="text-lg font-bold text-gray-900 dark:text-gray-100 mb-4">
              {cat.label}
            </h3>
            <div class="flex flex-wrap gap-2">
              {(site.skills[cat.key] as string[]).map((skill) => (
                <span class="inline-flex px-3 py-1 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 rounded text-sm font-medium hover:bg-blue-50 dark:hover:bg-blue-950 hover:text-blue-700 dark:hover:text-blue-300">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
