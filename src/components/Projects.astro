---
import {getCollection} from 'astro:content'; import ProjectCard from './ProjectCard.astro'; import {getUI,type Locale} from '../i18n/ui';
const locale=(Astro.currentLocale??'en') as Locale; const t=getUI(locale); const projects=await getCollection('projects',({data})=>data.locale===locale); projects.sort((a,b)=>a.data.featured===b.data.featured?b.data.title.localeCompare(a.data.title):a.data.featured?-1:1);
---
<section id="work" class="py-16 sm:py-24 border-t"><div class="max-w-3xl mx-auto px-6"><h2 class="text-3xl sm:text-4xl font-bold mb-12">{t.projects.title}</h2><div class="space-y-10">{projects.map(p=><ProjectCard labels={t.projects} {...p.data}/>)}</div></div></section>