---
import { projectData } from '../data/collections';
import { useTranslations, type Locale } from '../i18n/ui';
import ProjectCard from './ProjectCard.astro';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = useTranslations(locale);

// Sort by featured status and then by title
const sortedProjects = [...projectData].sort((a, b) => {
  if (a.featured && !b.featured) return -1;
  if (!a.featured && b.featured) return 1;
  return b.translations[locale].title.localeCompare(a.translations[locale].title);
});
---

<section
  id="work"
  class="py-16 sm:py-24 bg-gray-50 dark:bg-gray-900 border-t border-gray-200 dark:border-gray-800"
>
  <div class="max-w-3xl mx-auto px-6">
    <h2
      class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-gray-100 mb-12"
    >
      {t.projects.title}
    </h2>
    <div class="space-y-10">
      {
        sortedProjects.map((project) => {
          const trans = project.translations[locale];
          return (
            <ProjectCard
              title={trans.title}
              summary={trans.summary}
              problem={trans.problem}
              solution={trans.solution}
              result={trans.result}
              technologies={project.technologies}
              repository={project.repository}
              demo={project.demo}
            />
          );
        })
      }
    </div>
  </div>
</section>
