---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

const projects = await getCollection('projects');
// Sort by featured status and then by title
const sortedProjects = projects.sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return a.data.title.localeCompare(b.data.title);
});
---

<section id="work" class="py-16 sm:py-24 bg-gray-50 border-t border-gray-200">
  <div class="max-w-3xl mx-auto px-6">
    <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-12">
      Selected Technical Work
    </h2>
    <div class="space-y-10">
      {sortedProjects.map(project => (
        <ProjectCard
          title={project.data.title}
          summary={project.data.summary}
          problem={project.data.problem}
          solution={project.data.solution}
          result={project.data.result}
          technologies={project.data.technologies}
          repository={project.data.repository}
          demo={project.data.demo}
        />
      ))}
    </div>
  </div>
</section>
