---
import { projectData } from '../data/collections';
import { useTranslations, type Locale } from '../i18n/ui';
import ProjectCard from './ProjectCard.astro';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = useTranslations(locale);

// Sort by featured status and then by title
const sortedProjects = [...projectData].sort((a, b) => {
  if (a.featured && !b.featured) return -1;
  if (!a.featured && b.featured) return 1;
  return b.translations['en'].title.localeCompare(a.translations['en'].title);
});
---

<section
  id="work"
  class="border-t border-gray-200 bg-gray-50 py-16 sm:py-24 dark:border-gray-800 dark:bg-gray-900"
>
  <div class="mx-auto max-w-3xl px-6">
    <h2
      class="mb-12 text-3xl font-bold text-gray-900 sm:text-4xl dark:text-gray-100"
    >
      {t.projects.title}
    </h2>
    <div class="space-y-4" data-project-accordion>
      {
        sortedProjects.map((project) => {
          const trans = project.translations[locale];
          return (
            <ProjectCard
              title={trans.title}
              problem={trans.problem}
              solution={trans.solution}
              result={trans.result}
              technologies={project.technologies}
              repository={project.repository}
              demo={project.demo}
            />
          );
        })
      }
    </div>
  </div>
</section>

<script>
  const accordionItems = document.querySelectorAll(
    '[data-project-accordion-item]'
  );

  accordionItems.forEach((item) => {
    const trigger = item.querySelector('[data-project-trigger]');
    const panel = item.querySelector('[data-project-panel]');
    const icon = item.querySelector('[data-project-icon]');

    const setState = (isOpen: boolean) => {
      item.classList.toggle('is-open', isOpen);
      item.setAttribute('data-open', String(isOpen));
      trigger?.setAttribute('aria-expanded', String(isOpen));
      panel?.classList.toggle('is-open', isOpen);
      panel?.classList.toggle('is-closed', !isOpen);
      icon?.classList.toggle('rotate-180', isOpen);
    };

    trigger?.addEventListener('click', () => {
      const shouldOpen = item.getAttribute('data-open') !== 'true';

      accordionItems.forEach((otherItem) => {
        const otherTrigger = otherItem.querySelector('[data-project-trigger]');
        const otherPanel = otherItem.querySelector('[data-project-panel]');
        const otherIcon = otherItem.querySelector('[data-project-icon]');

        otherItem.classList.remove('is-open');
        otherItem.setAttribute('data-open', 'false');
        otherTrigger?.setAttribute('aria-expanded', 'false');
        otherPanel?.classList.remove('is-open');
        otherPanel?.classList.add('is-closed');
        otherIcon?.classList.remove('rotate-180');
      });

      setState(shouldOpen);
    });
  });
</script>
