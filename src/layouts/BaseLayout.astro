---
import { site } from '../data/site';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import { useTranslations, type Locale } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
}
const { locale, title = site.name, description } = Astro.props;
const t = useTranslations(locale);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description ?? t.description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="en" href={getAbsoluteLocaleUrl('en', '')} />
    <link rel="alternate" hreflang="es" href={getAbsoluteLocaleUrl('es', '')} />
    <link
      rel="alternate"
      hreflang="x-default"
      href={getAbsoluteLocaleUrl('en', '')}
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${import.meta.env.BASE_URL}/favicon.svg`}
    />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description ?? t.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:site_name" content={site.name} />

    <!-- Twitter Card -->
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description ?? t.description} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Preconnect to external services -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Dark mode inline script to prevent white flash on first load -->
    <script is:inline>
      const STORAGE_KEY = 'portfolio-theme-preference';

      const saved = localStorage.getItem(STORAGE_KEY);
      const parsed = saved ? JSON.parse(saved) : null;
      const mode = parsed?.mode;
      const darkTheme =
        mode === 'dark' ||
        (mode === null &&
          window.matchMedia('(prefers-color-scheme: dark)').matches);
      if (darkTheme) document.documentElement.classList.add('dark');
    </script>

    <!-- Recover scroll -->
    <script is:inline>
      history.scrollRestoration = 'manual';
      const scrollY = sessionStorage.getItem('scrollY');
      if (scrollY) {
        // Delay until the next frame to ensure the page has rendered before scrolling
        requestAnimationFrame(() => {
          window.scrollTo({ top: scrollY, behavior: 'instant' });
          sessionStorage.removeItem('scrollY');
        });
      }
    </script>

    <title>{title}</title>
  </head>
  <body class="bg-white text-gray-900 dark:bg-gray-950 dark:text-gray-100">
    <slot />
    <script src="../scripts/initialize.ts"></script>
  </body>
</html>
